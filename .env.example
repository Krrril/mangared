# Вход через Google (необязательно). Client ID не секретный — его можно
# смело коммитить, но проще держать рядом с остальными env-переменными.
# Получить: console.cloud.google.com -> Create Project -> APIs & Services
# -> Credentials -> Create Credentials -> OAuth client ID -> Web application
# -> Authorized JavaScript origins: http://localhost:5173
# Без этой переменной кнопка "Войти через Google" просто не показывается.
VITE_GOOGLE_CLIENT_ID=""

# Адрес бэкенда — по умолчанию http://localhost:4000/api, менять не нужно
# для локальной разработки.
# VITE_API_URL="http://localhost:4000/api"

# Вход через Яндекс (необязательно) — тот же принцип, что и у Google выше:
# Client ID не секретный, это только флаг "показывать кнопку". Секрет
# (YANDEX_CLIENT_SECRET) не сюда — только на бэкенд, см. server/.env.example.
# Получить Client ID: oauth.yandex.ru -> Зарегистрировать новое приложение.
# Без этой переменной кнопка "Войти через Яндекс" просто не показывается.
VITE_YANDEX_CLIENT_ID=""

# Cloudflare Turnstile — капча на форме регистрации (необязательно). Site
# Key тоже не секретный (в отличие от Secret Key на бэкенде, см.
# server/.env.example). Получить: dash.cloudflare.com -> Turnstile ->
# Add site -> указать домен(ы) -> тип виджета Managed -> скопировать Site Key.
# Без этой переменной виджет на регистрации просто не показывается —
# регистрация продолжает работать как раньше, без капчи.
VITE_TURNSTILE_SITE_KEY=""

# Google Analytics 4 (необязательно) — Measurement ID не секретный, виден
# в открытом JS на любом сайте с GA4. analytics.google.com -> Admin ->
# Data Streams -> ваш поток -> Measurement ID (формат G-XXXXXXXXXX).
# Без этой переменной GA4 просто не подключается (см. services/analytics).
VITE_GA_MEASUREMENT_ID=""

# Яндекс.Метрика (необязательно) — номер счётчика тоже не секретный.
# metrika.yandex.ru -> ваш счётчик -> номер в списке counters или в
# Настройках счётчика. Без этой переменной Метрика просто не подключается.
VITE_YANDEX_METRIKA_ID=""
