// Схема БД MangaRed backend.
// Мангу и главы мы не храним — только пользовательские данные.
// Сама манга (обложки, названия, страницы) всегда идёт "на лету" из
// MangaDex API, поэтому manga_id/chapter_id здесь — это просто строки
// с UUID из MangaDex, без foreign key на несуществующую у нас таблицу.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  // Нет пароля у пользователей, вошедших только через Google —
  // им нечего хешировать, поэтому поле опционально.
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  createdAt    DateTime @default(now()) @map("created_at")
  // Доступ к /admin — проставляется вручную в базе (Prisma Studio или
  // SQL UPDATE), самостоятельной регистрации админом нет и не будет.
  isAdmin      Boolean  @default(false) @map("is_admin")

  favorites Favorite[]
  progress  ReadingProgress[]
  // Профиль автора — не у каждого пользователя есть (создаётся при первой
  // публикации), поэтому 1:1 опциональная связь, не поле на User.
  authorProfile AuthorProfile?
  following     AuthorFollow[]
  chapterViews  ChapterView[]

  @@map("users")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mangaId   String   @map("manga_id") // id тайтла на MangaDex
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
  @@map("favorites")
}

model ReadingProgress {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  mangaId       String   @map("manga_id") // id тайтла на MangaDex
  chapterId     String   @map("chapter_id") // id главы на MangaDex
  chapterNumber Float    @map("chapter_number") // для отображения "Глава N" без лишнего похода в MangaDex
  pageNumber    Int      @map("page_number") // текущая страница внутри главы (0-индексация, как в читалке)
  updatedAt     DateTime @updatedAt @map("updated_at") // дата последнего чтения

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // У одного пользователя — одна запись прогресса на тайтл (последняя открытая глава/страница)
  @@unique([userId, mangaId])
  @@map("reading_progress")
}

// --- Публикация авторской манги/манхвы ("Originals") ---
// В отличие от каталога MangaDex выше (который мы не храним, только
// проксируем), это уже наш собственный контент — тайтлы, главы и
// страницы (URL в R2) реально живут в нашей базе.

enum MangaContentType {
  manga
  manhwa
  comic

  @@map("manga_content_type")
}

enum MangaStatus {
  draft
  pending
  published
  rejected

  @@map("manga_status")
}

model AuthorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  // Отдельный от email/id человекочитаемый идентификатор для URL
  // /author/:username — email в публичном профиле светить не хотим.
  username       String   @unique
  displayName    String   @map("display_name")
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  boostyUrl      String?  @map("boosty_url")
  // Денормализованный счётчик — на публичном профиле читается часто,
  // на каждый follow/unfollow дешевле ++/-- в транзакции, чем считать
  // count() по AuthorFollow при каждом заходе на страницу.
  followersCount Int      @default(0) @map("followers_count")
  createdAt      DateTime @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mangas    UserManga[]
  followers AuthorFollow[]

  @@map("author_profiles")
}

model UserManga {
  id          String           @id @default(uuid())
  authorId    String           @map("author_id")
  title       String
  description String
  coverUrl    String?          @map("cover_url")
  genres      String[]
  contentType MangaContentType @map("content_type")
  status      MangaStatus      @default(draft)
  // Согласие с правилами публикации (см. /publishing-rules) — обязательный
  // чекбокс на форме, фиксируем факт+момент именно этой публикации, не
  // общий флаг на профиле, поэтому поле здесь, а не на AuthorProfile.
  rulesAgreedAt DateTime       @map("rules_agreed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  author   AuthorProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@index([status])
  @@map("user_mangas")
}

model Chapter {
  id          String   @id @default(uuid())
  mangaId     String   @map("manga_id")
  number      Float
  title       String?
  // Порядок страниц = порядок в массиве — совпадает с семантикой
  // ReadingProgress.pageNumber в остальном приложении.
  pages       String[]
  publishedAt DateTime @default(now()) @map("published_at")
  // Простой счётчик открытий главы — увеличивается на каждый публичный
  // GET главы (см. routes/originals.ts). Не полноценная аналитика (той
  // сознательно нет в этом этапе, см. ROADMAP) — только сумма для
  // "суммарные прочтения" на публичном профиле автора.
  viewsCount  Int      @default(0) @map("views_count")

  manga UserManga @relation(fields: [mangaId], references: [id], onDelete: Cascade)

  @@unique([mangaId, number])
  @@map("user_manga_chapters")
}

// --- Счётчики просмотров/лайков (для MangaDex-тайтлов и Originals разом) ---
// mangaId — единое пространство id: либо UUID тайтла с MangaDex, либо
// UserManga.id нашей публикации — оба просто строки, коллизия
// практически невозможна (разные генераторы UUID), поэтому одна таблица
// на оба источника, без отдельного поля-дискриминатора здесь.

model TitleStats {
  mangaId String @id @map("manga_id")
  // "Лайки" — это и есть избранное (см. Favorite): считаем то же самое
  // действие, отдельной сущности "лайк" нет (см. DECISIONS.md).
  viewsCount     Int      @default(0) @map("views_count")
  favoritesCount Int      @default(0) @map("favorites_count")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("title_stats")
}

// Сырой лог просмотров глав — не для прямого отображения (для этого
// денормализованные счётчики выше), а как: 1) дедупликация повторных
// просмотров одной и той же главы одним пользователем (не чаще раза в
// день — см. ARCHITECTURE.md), 2) сырые данные на будущее для авторской
// статистики с графиками (просмотры по дням), которую сейчас не строим,
// но откладывать сбор данных до того момента поздно — прошлое не
// восстановить.
model ChapterView {
  id      String @id @default(uuid())
  // null — гость: посчитан безусловно, без защиты от накрутки (решение
  // пользователя, см. DECISIONS.md — надёжно опознать гостя нечем).
  userId    String?  @map("user_id")
  mangaId   String   @map("manga_id")
  chapterId String   @map("chapter_id")
  // Только дата (без времени) — единица дедупликации "раз в день".
  viewDate  DateTime @db.Date @map("view_date")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Уникальность триггерит только для авторизованных: NULL в Postgres не
  // равен другому NULL, поэтому у гостей (userId = null) это ограничение
  // никогда не сработает — ровно то поведение, которое нужно (см. выше).
  @@unique([userId, chapterId, viewDate])
  @@index([mangaId])
  @@map("chapter_views")
}

model AuthorFollow {
  id         String   @id @default(uuid())
  followerId String   @map("follower_id")
  authorId   String   @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower User          @relation(fields: [followerId], references: [id], onDelete: Cascade)
  author   AuthorProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([followerId, authorId])
  @@map("author_follows")
}
