DATABASE_URL="postgresql://postgres:password@localhost:5432/mangared?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Вход через Google (необязательно). Получить: console.cloud.google.com
# -> Create Project -> APIs & Services -> Credentials -> Create Credentials
# -> OAuth client ID -> Web application -> Authorized JavaScript origins:
# http://localhost:5173. Секрет не нужен — только Client ID, он не секретный.
# Без этой переменной кнопка "Войти через Google" на сайте просто не покажется.
GOOGLE_CLIENT_ID=""

# Хранилище файлов для авторской манги (обложки, страницы глав, аватары) —
# Cloudflare R2 (S3-совместимое, без платы за исходящий трафик).
# Получить: dash.cloudflare.com -> R2 -> Create bucket -> Manage R2 API
# tokens -> Create API token (Object Read & Write) -> скопировать
# Account ID, Access Key ID, Secret Access Key.
# R2_PUBLIC_URL — включить публичный доступ бакету (R2.dev subdomain или
# свой домен) и указать этот адрес без слэша на конце.
# Без этих переменных POST /api/upload отвечает 503 — публикация автором
# работ становится недоступна, остальной сайт (каталог MangaDex) не
# затрагивается.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Восстановление пароля по email (необязательно) — письма отправляются
# через обычный Gmail-аккаунт (не настоящий пароль от аккаунта, а
# отдельный "пароль приложения"):
# 1. На Gmail-аккаунте должна быть включена двухфакторная аутентификация
#    (myaccount.google.com -> Security -> 2-Step Verification).
# 2. myaccount.google.com -> Security -> App passwords -> создать пароль
#    приложения (любое имя, например "MangaGreen") -> скопировать
#    16-значный код без пробелов.
# Без этих переменных POST /api/auth/forgot-password отвечает 200 (чтобы
# не выдавать существование email), но письмо не отправляется — только
# логируется ошибка на сервере, остальной сайт не затрагивается.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Вход через Яндекс (необязательно) — redirect-флоу (см. routes/auth.ts,
# /yandex/start и /yandex/callback), не popup, как у Google: у Яндекса нет
# аналога Google Identity Services. Получить:
# 1. oauth.yandex.ru -> Зарегистрировать новое приложение.
# 2. Платформы: отметить "Веб-сервисы".
# 3. Redirect URI (точно, включая путь): для прода —
#    https://mangared-api.onrender.com/api/auth/yandex/callback
#    для локальной разработки — http://localhost:4000/api/auth/yandex/callback
#    (можно указать оба одновременно, Яндекс разрешает несколько).
# 4. Доступы (scopes): "Доступ к email" (login:email) и
#    "Доступ к имени, фамилии и полу" (login:info).
# 5. Скопировать ID и Пароль (Client Secret) со страницы приложения.
# Без этих переменных кнопка "Войти через Яндекс" на сайте не покажется
# (см. VITE_YANDEX_CLIENT_ID во фронтенд-.env.example), а /yandex/start
# отвечает редиректом на /auth с ошибкой, если её всё же дёрнуть напрямую.
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
# Должен точно совпадать с тем, что указан в панели oauth.yandex.ru (см.
# выше) — по умолчанию (если не задать) используется адрес для локальной
# разработки, на проде обязательно переопределить.
YANDEX_REDIRECT_URI=""

# Cloudflare Turnstile — капча на форме регистрации (необязательно).
# Secret Key — секретный, в отличие от Site Key на фронтенде (см.
# VITE_TURNSTILE_SITE_KEY во фронтенд-.env.example). Получить:
# dash.cloudflare.com -> Turnstile -> Add site -> указать домен(ы) -> тип
# виджета Managed -> скопировать Secret Key (Site Key — там же, но он идёт
# на фронтенд, не сюда).
# Без этой переменной POST /api/auth/register пропускает проверку капчи
# целиком (см. isTurnstileConfigured в utils/turnstile.ts) — регистрация
# продолжает работать, просто без этого барьера.
TURNSTILE_SECRET_KEY=""
